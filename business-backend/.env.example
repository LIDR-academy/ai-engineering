# Postgres connection (consumed by config/database.yml).
# Inside docker compose, the host resolves to the `postgres` service.
# When running Rails locally without docker, leave these blank to fall back to
# the Unix-domain socket.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Rails runtime
RAILS_ENV=development
RAILS_MAX_THREADS=5

# Cross-service URL for the FastAPI estimator (server-side, Rails → FastAPI).
# Resolves only when both projects are launched together via the master compose.
ESTIMATOR_API_BASE_URL=http://ai-service:8000

# Faraday timeout (seconds) for the estimator HTTP client. LLM calls with
# structured output via Instructor can re-prompt several times, leave plenty
# of head room.
ESTIMATOR_AI_TIMEOUT=180

# Session 9 RAG wizard — API keys for the secured FastAPI endpoints
# (X-API-Key header). Must match the estimator's RETRIEVAL_API_KEY /
# ESTIMATE_API_KEY. Blank disables the wizard (every call returns 401).
RETRIEVAL_API_KEY=demo-retrieval-key
ESTIMATE_API_KEY=demo-estimate-key

# Session 15: shared service token sent on EVERY call to the AI service
# (X-Service-Token header). Must match AI_SERVICE_TOKEN on the FastAPI side.
# Blank is valid and means the AI service has the check disabled — the normal
# state when running it locally outside Docker.
# Under docker compose this comes from the ROOT .env, not from here.
AI_SERVICE_TOKEN=
