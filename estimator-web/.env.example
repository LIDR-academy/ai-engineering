# estimator-web — Rails frontend. No OpenAI/Anthropic keys here: the cliente
# only talks to FastAPI. Copy this file to `.env` before `docker compose up`.

# FastAPI estimator. Leave UNSET in Docker: compose injects
# http://estimator:8000 and Foreman would otherwise overwrite it with this file.
# Set to http://localhost:8000 only if you run Rails on the host with `bin/dev`.
# ESTIMATOR_API_BASE_URL=http://localhost:8000
ESTIMATOR_AI_TIMEOUT=180

# Session 9 RAG wizard (X-API-Key). MUST MATCH estimator/.env or every RAG
# request returns 401. Leave blank to disable the wizard.
RETRIEVAL_API_KEY=demo-retrieval-key
ESTIMATE_API_KEY=demo-estimate-key

# Postgres — Compose already injects these. Unset = Unix socket (local, no Docker).
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
